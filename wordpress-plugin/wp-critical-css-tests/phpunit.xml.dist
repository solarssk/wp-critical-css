<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
	bootstrap="tests/php/bootstrap.php"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	convertDeprecationsToExceptions="false"
>
	<testsuites>
		<testsuite name="wp-critical-css">
			<!--
			Listed explicitly, in this exact order, rather than as a single
			<directory> glob: WPCC_SHARED_SECRET is a define()d constant, so it
			can only ever be truly *undefined* once per PHPUnit process.
			MissingSecretTest.php depends on that and must run before any other
			file (all of which define it via the WPCC_Configured_Secret trait,
			once, on first use) - see MissingSecretTest.php's own docblock.
			-->
			<file>./tests/php/MissingSecretTest.php</file>
			<file>./tests/php/SharedCssSanitizerTest.php</file>
			<file>./tests/php/ReceiverTest.php</file>
			<file>./tests/php/TriggerTest.php</file>
			<file>./tests/php/InjectTest.php</file>
			<file>./tests/php/AdminNoticeTest.php</file>
		</testsuite>
	</testsuites>
	<coverage>
		<include>
			<!--
			Relative to THIS file's own directory (wp-critical-css-tests/),
			not the shipped plugin's own root - the plugin source lives in
			the sibling wp-critical-css/ directory (kept out of this one so
			publish-plugin.yml's zip of wp-critical-css/ never includes any
			dev/test tooling - see this repo's .gitignore for the same
			reasoning). ../wp-critical-css/, not ./ - these paths silently
			matched nothing before this comment was added, since neither
			./includes nor ./wp-critical-css.php exist in this directory at
			all - PHPUnit doesn't error on an empty coverage filter, it just
			silently reports 0% for everything.
			-->
			<directory suffix=".php">../wp-critical-css/includes</directory>
			<file>../wp-critical-css/wp-critical-css.php</file>
		</include>
	</coverage>
</phpunit>
