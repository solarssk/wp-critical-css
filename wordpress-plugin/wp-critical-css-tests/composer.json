{
	"name": "solarssk/wp-critical-css",
	"description": "Dev tooling (PHPUnit, PHPCS/WPCS) for the WP Critical CSS plugin. Not required at runtime - the plugin itself has no PHP dependencies.",
	"license": "MIT",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0",
		"wp-phpunit/wp-phpunit": "^7.1",
		"johnpbloch/wordpress-core": "^7.1",
		"johnpbloch/wordpress-core-installer": "^2.0",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"johnpbloch/wordpress-core-installer": true
		},
		"platform": {
			"php": "7.4.0"
		}
	},
	"extra": {
		"wordpress-install-dir": "tests/php/wordpress-core"
	},
	"scripts": {
		"test": "phpunit -c phpunit.xml.dist",
		"phpcs": "phpcs"
	}
}
