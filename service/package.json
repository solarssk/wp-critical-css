{
  "name": "wp-critical-css",
  "version": "0.2.8",
  "description": "Self-hosted critical CSS generator for WordPress, using a real headless browser (penthouse on Puppeteer).",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --require ./scripts/raise-test-runner-max-listeners.cjs --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info --test-reporter=junit --test-reporter-destination=junit.xml"
  },
  "dependencies": {
    "clean-css": "^5.3.3",
    "css-mediaquery": "^0.1.2",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "parse5": "^8.0.1",
    "penthouse-esm": "^3.0.0",
    "postcss": "^8.5.28",
    "postcss-url": "^10.1.4",
    "puppeteer": "^25.13.0",
    "undici": "^8.11.2",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
