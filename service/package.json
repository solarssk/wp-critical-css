{
  "name": "wp-critical-css",
  "version": "0.2.0",
  "description": "Self-hosted critical CSS generator for WordPress, using a real headless browser via the critical package.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info --test-reporter=junit --test-reporter-destination=junit.xml"
  },
  "dependencies": {
    "critical": "^8.0.0",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "puppeteer": "^25.9.0",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=24"
  }
}
