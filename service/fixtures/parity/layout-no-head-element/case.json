{
	"description": "A page without any <head> start tag gets no injection at all (the layout copy equals the page).",
	"pageUrl": "{{site}}/",
	"layout": true,
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/main.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "main.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/main.css",
			{
				"inline": ".inline-rule{margin:0}"
			}
		],
		"stylesheetsMedia": [
			"",
			""
		],
		"layoutFile": "expected-layout.html"
	}
}
