{
	"description": "Two <head> elements: the second one is merged into the first by the parser, both links discovered in order.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/h1.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "h1.css"
		},
		"/wp-content/themes/twentytest/h2.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "h2.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/h1.css",
			"{{site}}/wp-content/themes/twentytest/h2.css"
		],
		"stylesheetsMedia": [
			"",
			""
		]
	}
}
