{
	"description": "A stylesheet served as text/plain is used as css.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/tp.css": {
			"status": 200,
			"type": "text/plain; charset=utf-8",
			"file": "tp.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/tp.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
