{
	"description": "The page URL answers 302 to another directory; a relative href resolves against the FINAL URL.",
	"pageUrl": "{{site}}/start",
	"routes": {
		"/start": {
			"status": 302,
			"type": "text/plain; charset=UTF-8",
			"body": "Redirecting to /blog/landing/",
			"headers": {
				"location": "/blog/landing/"
			}
		},
		"/blog/landing/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/blog/landing/style.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "style.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/blog/landing/index.html",
		"stylesheets": [
			"style.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
