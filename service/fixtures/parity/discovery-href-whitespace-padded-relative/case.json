{
	"description": "A RELATIVE href with leading/trailing blanks (\"  css/a.css  \") from a nested page.",
	"pageUrl": "{{site}}/blog/post.html",
	"routes": {
		"/blog/post.html": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/blog/css/a.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "a.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/blog/post.html",
		"stylesheets": [
			"  css/a.css  "
		],
		"stylesheetsMedia": [
			""
		]
	}
}
