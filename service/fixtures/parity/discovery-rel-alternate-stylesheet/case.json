{
	"description": "rel=\"alternate stylesheet\" (an alternate style sheet with a title) is discovered like any other stylesheet.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/alt.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "alt.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/alt.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
