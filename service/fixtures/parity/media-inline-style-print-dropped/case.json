{
	"description": "An inline <style media=\"print\"> is dropped; media=\"all\" and media=\"screen\" are kept unwrapped.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
