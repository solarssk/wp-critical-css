{
	"description": "Entities inside <style> are raw text, not decoded (content:\"&amp;\" stays &amp;).",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			{
				"inline": ".amp::after{content:\"&amp; &lt; &quot;\"}"
			}
		],
		"stylesheetsMedia": [
			""
		]
	}
}
