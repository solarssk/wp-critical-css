{
	"description": "Inline <style> with an @font-face src list.",
	"pageUrl": "{{site}}/blog/hello-world/",
	"routes": {
		"/blog/hello-world/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/blog/hello-world/index.html",
		"stylesheets": [
			{
				"inline": "\n@font-face{font-family:\"Inline\";src:url(fonts/i.woff2) format(\"woff2\"),url(../fonts/i.woff) format(\"woff\")}\n"
			}
		],
		"stylesheetsMedia": [
			""
		]
	}
}
