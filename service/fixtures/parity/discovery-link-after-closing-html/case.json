{
	"description": "A link printed after </html> is moved into the body by the parser and discovered.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/before.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "before.css"
		},
		"/wp-content/themes/twentytest/afterhtml.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "afterhtml.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/before.css",
			"{{site}}/wp-content/themes/twentytest/afterhtml.css"
		],
		"stylesheetsMedia": [
			"",
			""
		]
	}
}
