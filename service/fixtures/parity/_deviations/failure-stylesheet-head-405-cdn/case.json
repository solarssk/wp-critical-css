{
	"description": "The CDN rejects HEAD (405) but serves the stylesheet on GET: critical silently drops the sheet.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"{{cdn}}/assets/css/nohead.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "nohead.css",
			"head": {
				"status": 405
			}
		},
		"/wp-content/themes/twentytest/before.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "before.css"
		},
		"/wp-content/themes/twentytest/after.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "after.css"
		}
	},
	"thin": {
		"kind": "differs",
		"note": "The new layer sends GET only, so the sheet is fetched and included (expected-thin.css).",
		"derive": {
			"routes": {
				"{{cdn}}/assets/css/nohead.css": {
					"head": null
				}
			}
		},
		"cssFile": "expected-thin.css"
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/before.css",
			"{{cdn}}/assets/css/nohead.css",
			"{{site}}/wp-content/themes/twentytest/after.css"
		],
		"stylesheetsMedia": [
			"",
			"",
			""
		]
	}
}
