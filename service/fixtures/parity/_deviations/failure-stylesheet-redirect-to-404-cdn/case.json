{
	"description": "A CDN stylesheet redirects (302) to a URL that answers 404: critical silently drops it.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"{{cdn}}/assets/css/moved.css": {
			"status": 302,
			"type": "text/plain; charset=UTF-8",
			"body": "Redirecting to /assets/css/nowhere.css",
			"headers": {
				"location": "/assets/css/nowhere.css"
			}
		},
		"/wp-content/themes/twentytest/before.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "before.css"
		},
		"/wp-content/themes/twentytest/after.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "after.css"
		}
	},
	"thin": {
		"kind": "skip",
		"note": "A failed stylesheet on another host (CDN / third party) is skipped with one logSafe'd warning and the job succeeds. (In these fixtures {{site}} and {{cdn}} share the hostname 127.0.0.1 and differ only by port: \"same host\" must compare host:port, as the url() rebasing does, or be injectable.)"
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/before.css",
			"{{cdn}}/assets/css/moved.css",
			"{{site}}/wp-content/themes/twentytest/after.css"
		],
		"stylesheetsMedia": [
			"",
			"",
			""
		]
	}
}
