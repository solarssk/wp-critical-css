{
	"description": "A stylesheet link that exists only inside <noscript> is not discovered (noscript content is text for the parser).",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/main.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "main.css"
		},
		"/wp-content/themes/twentytest/noscript.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "noscript.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/main.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
