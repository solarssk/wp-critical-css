{
	"description": "Inline <style> on a page whose URL has a query string and no trailing slash.",
	"pageUrl": "{{site}}/shop/item.php?id=7",
	"routes": {
		"/shop/item.php?id=7": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		}
	},
	"expect": {
