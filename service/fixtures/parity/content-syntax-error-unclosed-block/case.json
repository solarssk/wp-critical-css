{
	"description": "Css with an unclosed block (missing }) between two good sheets: the broken sheet is silently emptied.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/before.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "before.css"
		},
		"/wp-content/themes/twentytest/bad.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "bad.css"
		},
		"/wp-content/themes/twentytest/after.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "after.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/before.css",
			"{{site}}/wp-content/themes/twentytest/bad.css",
			"{{site}}/wp-content/themes/twentytest/after.css"
		],
		"stylesheetsMedia": [
			"",
			"",
			""
		]
	}
}
