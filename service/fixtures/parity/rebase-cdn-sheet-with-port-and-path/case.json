{
	"description": "CDN sheet whose URL has a query string and a deep path: urls resolve against the path, not the query.",
	"pageUrl": "{{site}}/blog/hello-world/",
	"routes": {
		"/blog/hello-world/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"{{cdn}}/v2/theme/css/main.css?ver=5&x=y/z": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "main.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/blog/hello-world/index.html",
		"stylesheets": [
			"{{cdn}}/v2/theme/css/main.css?ver=5&x=y/z"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
