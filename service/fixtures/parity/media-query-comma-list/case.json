{
	"description": "A comma separated media query list is wrapped as one @media prelude.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/mlist.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "mlist.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/mlist.css"
		],
		"stylesheetsMedia": [
			"screen and (max-width: 600px), print and (orientation: landscape)"
		]
	}
}
