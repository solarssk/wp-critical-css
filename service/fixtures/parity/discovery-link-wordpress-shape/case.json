{
	"description": "The exact markup WordPress prints for an enqueued stylesheet (single quotes, id, ?ver=, type, media=all, self-closing).",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/style.css?ver=1.0.3": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "style.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/style.css?ver=1.0.3"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
