{
	"description": "Same-host sheet: url(%23x) is left alone, a blank INSIDE the quotes is kept, a root-relative url keeps its query and hash.",
	"pageUrl": "{{site}}/blog/hello-world/",
	"routes": {
		"/blog/hello-world/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/css/main.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "main.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/blog/hello-world/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/css/main.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
