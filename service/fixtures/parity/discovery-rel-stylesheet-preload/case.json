{
	"description": "rel=\"stylesheet preload\": a token list containing stylesheet is discovered once.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/sp.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "sp.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/sp.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
