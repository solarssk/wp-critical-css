{
	"description": "Location is an absolute URL on the same host.",
	"pageUrl": "{{site}}/old/",
	"routes": {
		"/old/": {
			"status": 301,
			"type": "text/plain; charset=UTF-8",
			"body": "Redirecting to {{site}}/new/location/",
			"headers": {
				"location": "{{site}}/new/location/"
			}
		},
		"/new/location/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/style.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "style.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/new/location/index.html",
		"stylesheets": [
			"/wp-content/themes/twentytest/style.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
