{
	"description": "The sheet is in a deeper directory than the page: /blog/hello-world/ vs /a/b/c/d/s.css.",
	"pageUrl": "{{site}}/blog/hello-world/",
	"routes": {
		"/blog/hello-world/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/a/b/c/d/s.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "s.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/blog/hello-world/index.html",
		"stylesheets": [
			"{{site}}/a/b/c/d/s.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
