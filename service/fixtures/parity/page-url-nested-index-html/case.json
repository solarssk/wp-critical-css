{
	"description": "Page at /blog/index.html (a directory index spelled out).",
	"pageUrl": "{{site}}/blog/index.html",
	"routes": {
		"/blog/index.html": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/style.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "style.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/blog/index.html",
		"stylesheets": [
			"/wp-content/themes/twentytest/style.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
