{
	"description": "A stylesheet href with a scheme other than http(s) (ftp://) is dropped silently; the sheets around it are kept.",
	"proposal": true,
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/before.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "before.css"
		},
		"/wp-content/themes/twentytest/after.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "after.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/before.css",
			"ftp://files.example.invalid/style.css",
			"{{site}}/wp-content/themes/twentytest/after.css"
		],
		"stylesheetsMedia": [
			"",
			"",
			""
		]
	}
}
