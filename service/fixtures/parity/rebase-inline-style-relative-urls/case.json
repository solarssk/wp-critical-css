{
	"description": "Inline <style> on a nested page: relative urls are relative to the page itself, so they stay unchanged.",
	"pageUrl": "{{site}}/blog/hello-world/",
	"routes": {
		"/blog/hello-world/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/blog/hello-world/index.html",
		"stylesheets": [
			{
				"inline": "\n.rb1{background:url(img/a.png)}\n.rb2{background:url(../img/b.png)}\n.rb3{background:url(./c.png)}\n"
			}
		],
		"stylesheetsMedia": [
			""
		]
	}
}
