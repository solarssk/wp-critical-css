{
	"description": "The onload test is case-sensitive: onload=\"this.MEDIA='all'\" does not contain \"media\", so the print sheet is dropped.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/keep.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "keep.css"
		},
		"/wp-content/themes/twentytest/uponload.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "uponload.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/keep.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
