{
	"description": "Relative href \"./style.css\" from a page at /blog/post.html resolves to /blog/style.css.",
	"pageUrl": "{{site}}/blog/post.html",
	"routes": {
		"/blog/post.html": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/blog/style.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "style.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/blog/post.html",
		"stylesheets": [
			"./style.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
