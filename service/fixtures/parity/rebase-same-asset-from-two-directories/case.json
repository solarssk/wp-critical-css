{
	"description": "Two sheets in different directories reference \"../img/logo.png\": each resolves to a different file.",
	"pageUrl": "{{site}}/blog/hello-world/",
	"routes": {
		"/blog/hello-world/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/a/css/s.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "a.css"
		},
		"/b/css/s.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "b.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/blog/hello-world/index.html",
		"stylesheets": [
			"{{site}}/a/css/s.css",
			"{{site}}/b/css/s.css"
		],
		"stylesheetsMedia": [
			"",
			""
		]
	}
}
