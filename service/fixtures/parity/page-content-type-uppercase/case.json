{
	"description": "The page is served with an upper-case media type and parameter name (TEXT/HTML; CHARSET=UTF-8).",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "TEXT/HTML; CHARSET=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/x.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "x.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/x.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
