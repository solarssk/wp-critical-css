{
	"description": "Content-Type says charset=iso-8859-1 but the bytes are UTF-8: the header is ignored, bytes are decoded as UTF-8.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/lat.css": {
			"status": 200,
			"type": "text/css; charset=iso-8859-1",
			"file": "lat.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/lat.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
