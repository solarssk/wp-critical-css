{
	"description": "A > inside a <head> attribute value ends the matched start tag early: the css lands inside the attribute value.",
	"pageUrl": "{{site}}/",
	"layout": true,
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/main.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "main.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/main.css"
		],
		"stylesheetsMedia": [
			""
		],
		"layoutFile": "expected-layout.html"
	}
}
