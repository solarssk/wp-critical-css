{
	"description": "A media-conditional sheet that itself contains @charset and @import: they end up inside the @media wrapper.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/wrapimp.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "wrapimp.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/wrapimp.css"
		],
		"stylesheetsMedia": [
			"(min-width: 800px)"
		]
	}
}
