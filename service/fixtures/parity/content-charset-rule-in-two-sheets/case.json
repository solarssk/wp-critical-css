{
	"description": "Two sheets each starting with @charset: the second @charset ends up in the middle of the joined css.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/c1.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "c1.css"
		},
		"/wp-content/themes/twentytest/c2.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "c2.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/c1.css",
			"{{site}}/wp-content/themes/twentytest/c2.css"
		],
		"stylesheetsMedia": [
			"",
			""
		]
	}
}
