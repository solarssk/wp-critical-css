{
	"description": "The stylesheet is served gzip-compressed (Content-Encoding: gzip) because the client asks for it.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/gz.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "gz.css",
			"encoding": "gzip"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/gz.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
