{
	"description": "A <style> containing only whitespace is a (blank) stylesheet: what that does to the joined css.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/before.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "before.css"
		},
		"/wp-content/themes/twentytest/after.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "after.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/before.css",
			{
				"inline": "   \n  "
			},
			"{{site}}/wp-content/themes/twentytest/after.css"
		],
		"stylesheetsMedia": [
			"",
			"",
			""
		]
	}
}
