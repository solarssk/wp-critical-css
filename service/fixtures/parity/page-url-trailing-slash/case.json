{
	"description": "Page at /blog/hello-world/ (WordPress permalink): index.html is appended to the virtual path.",
	"pageUrl": "{{site}}/blog/hello-world/",
	"routes": {
		"/blog/hello-world/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/style.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "style.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/blog/hello-world/index.html",
		"stylesheets": [
			"/wp-content/themes/twentytest/style.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
