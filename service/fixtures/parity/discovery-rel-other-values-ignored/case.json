{
	"description": "rel=\"icon\", \"canonical\", \"dns-prefetch\", \"prefetch\" (even with as=style) and \"alternate\" are not stylesheets; only the real link is discovered.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/real.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "real.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/real.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
