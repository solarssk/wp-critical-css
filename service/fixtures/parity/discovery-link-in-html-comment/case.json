{
	"description": "Links inside an HTML comment and inside an IE conditional comment are not discovered.",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/real.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "real.css"
		},
		"/wp-content/themes/twentytest/commented.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "commented.css"
		},
		"/wp-content/themes/twentytest/ie.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "ie.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/real.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
