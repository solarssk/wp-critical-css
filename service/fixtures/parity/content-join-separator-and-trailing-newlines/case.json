			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/j1.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "j1.css"
		},
		"/wp-content/themes/twentytest/j2.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "j2.css"
