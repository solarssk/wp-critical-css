{
	"description": "Page at the site root: urls become root-directory-relative (no ../).",
	"pageUrl": "{{site}}/",
	"routes": {
		"/": {
			"status": 200,
			"type": "text/html; charset=UTF-8",
			"file": "page.html"
		},
		"/wp-content/themes/twentytest/css/main.css": {
			"status": 200,
			"type": "text/css; charset=UTF-8",
			"file": "main.css"
		}
	},
	"expect": {
		"kind": "css",
		"cssFile": "expected.css",
		"virtualPath": "/index.html",
		"stylesheets": [
			"{{site}}/wp-content/themes/twentytest/css/main.css"
		],
		"stylesheetsMedia": [
			""
		]
	}
}
