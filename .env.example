# Copy to .env (or wire these into your compose stack's environment). Keep
# the real file out of git - it holds the shared secret that authenticates
# both directions of the webhook (WordPress -> generator, generator ->
# WordPress).
#
# IMPORTANT: SHARED_SECRET below must ALSO be added to your site's
# wp-config.php as:
#   define( 'WPCC_SHARED_SECRET', '<same value as SHARED_SECRET below>' );
# It is deliberately NOT hardcoded in the mu-plugin files (those are meant
# to be tracked in git) - if it's missing from wp-config.php, the WordPress
# side fails closed (rejects everything) rather than falling back to a
# value baked into source.
#
# Generate a secret with: openssl rand -hex 32

PORT=3939

SHARED_SECRET=<generate with: openssl rand -hex 32>

# If the generator container joins the same Docker network as WordPress,
# use the internal service/container name - no public exposure needed.
WP_RECEIVER_URL=http://wordpress:80/wp-json/wpcc/v1/critical-css

# Only URLs on this hostname are ever rendered - without this check, a
# leaked SHARED_SECRET would turn /generate into an open SSRF proxy.
ALLOWED_HOSTNAME=example.com

SITE_SITEMAP_URL=https://example.com/sitemap_index.xml

# Cron syntax, container-local time. Default: once a day at 03:00.
SWEEP_CRON=0 3 * * *
SWEEP_ENABLED=true

# Delay between sitemap-sweep URLs, milliseconds. Keeps Chrome from
# processing the whole site's back-catalog in one CPU/memory burst.
SWEEP_DELAY_MS=5000
